include README.md README.es.md LICENSE CHANGELOG.md CONTRIBUTING.md SECURITY.md AGENTS.md
recursive-include docs *.md
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github *.yml *.md
prune build
prune dist
prune .venv
global-exclude __pycache__ *.py[cod] *.iso *.img *.wim *.esd *.swm *.exe *.msi *.inf *.sys *.cat *.log .env .env.* *.pem *.key
